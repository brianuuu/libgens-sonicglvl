  <PathStartProp type="float" default="0" description="" />
  <Speed type="float" default="40" description="" />
  <GroundOffset type="float" default="0" description="" />
  <IsCastShadow type="bool" default="true" description="" />
  <Range type="float" default="10000" description="" />
  <Extra type="model" name="twn_car_compact.model" condition="Type == 0"/>
  <Extra type="model" name="twn_car_sedan.model" condition="Type == 1"/>
  <Extra type="model" name="twn_car_wagon.model" condition="Type == 2"/>
</Template>
