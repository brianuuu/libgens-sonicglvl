<?xml version="1.0" ?>
<Template>
  <Type type="integer" default="0" description="" preset0="0 (Compact)" preset1="1 (Sedan)" preset2="2 (Wagon)"/>
  <Color type="integer" default="0" description="" preset0="0 (White)" preset1="1 (Silver)" preset2="2 (Grey)" preset3="3 (Black)" preset4="4 (Red)" preset5="5 (Brown)" preset6="6 (Blue)" preset7="7 (Green)"/>
